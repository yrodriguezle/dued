# === DuedGusto Production Environment ===
# Copy to .env and fill with real values
# chmod 600 .env

# MySQL
MYSQL_ROOT_PASSWORD=changeme_mysql_root_password
MYSQL_DATABASE=duedgusto

# Backend .NET
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET_KEY=changeme_generate_with_openssl_rand_base64_64
SUPERADMIN_PASSWORD=changeme_superadmin_password

# Server IP (no domain)
# SERVER_IP=<IP_PUBBLICO_VPS>

# === Gestionale: l'origine che finisce in config.json ===
# 🔴 Se NON è definita, deploy.sh cabla l'IP del server — che è ciò che rompe il cutover:
#    servendo la cassa da https://app.duedgusto.it, una SPA che chiama https://<IP> parla
#    con un ALTRO origin, con un certificato che non nomina l'IP. Preflight CORS fallito,
#    cookie del refresh token non inviato, login impossibile, e la pipeline verde.
#    Si valorizza il giorno in cui il DNS punta al VPS, non prima.
# APP_ORIGINE_PUBBLICA=https://app.duedgusto.it

# CORS: host autorizzati a chiamare l'API da un origin diverso, separati da virgola.
# Solo host, senza schema né porta. SERVER_IP viene aggiunto in automatico.
# Nginx serve app e API sullo stesso origin, quindi qui vanno solo gli host che
# puntano all'API da un dominio diverso.
ALLOWED_ORIGINS=app.duedgusto.it

# === Sito vetrina (Astro) ===
# L'origine PUBBLICA da cui il browser del visitatore scarica le foto: finisce dentro
# src/srcset delle immagini e dentro og:image, quindi deve essere assoluta e https.
#
# 🔴 È un ARGOMENTO DI BUILD, non una variabile di runtime. `astro:env` la inlina nel
#    bundle: cambiarla qui NON ha effetto finché l'immagine non viene RICOSTRUITA
#    (`docker compose build sito`). Un restart non basta e non dà alcun errore.
#
# L'altra origine (API_INTERNA_URL) non sta qui: è fissa a http://backend:5000 nel
# docker-compose, perché è la rete interna di Docker e non dipende dall'ambiente.
SITO_ORIGINE_PUBBLICA=https://duedgusto.it

# === Listino 2026 ===
# Normalmente NON serve toccare nulla: il docker-compose arma entrambi i seeder a `1`,
# perché sono idempotenti e dopo la prima esecuzione non fanno più niente.
#
# Le due righe qui sotto servono solo per due casi:
#   · `dryrun` — elenca nei log cosa verrebbe creato o pubblicato, senza scrivere;
#   · `0` (o qualunque altro valore) — spegne il seeder, se un giorno servisse.
#
# ⚠️ Perché tenerli accesi non calpesta il lavoro dell'amministratore:
#      SeedProdottiListino  crea solo i codici ancora assenti;
#      SeedVetrinaListino   tocca solo i prodotti «mai curati» — categoria di vetrina
#                           nulla E non pubblicati — quindi spubblicare un piatto dal
#                           pannello resta una decisione definitiva.
# SEED_LISTINO_2026=dryrun
# SEED_VETRINA_LISTINO=dryrun
