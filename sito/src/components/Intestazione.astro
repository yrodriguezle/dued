---
// L'intestazione appiccicata: logo, navigazione, stato, registro, richiamo.
//
// ⚠️ **La navigazione del mockup non ci sta su un telefono.** Cinque pastiglie più la
//    pastiglia di stato, il bottone del tema e «Prenota un tavolo» fanno circa 700 px, su
//    una larghezza di 360. Qui la fila scorre in orizzontale sotto la riga del logo, con
//    `scrollbar-width: none`: tutte le voci restano raggiungibili, nessuna finisce dentro un
//    menu che va aperto, e non serve JavaScript. Da `lg` in su torna la riga unica del
//    mockup.
//
// ⚠️ Il richiamo «Prenota un tavolo» **compare solo se c'è un telefono** in anagrafica: un
//    bottone d'azione che non porta da nessuna parte è peggio di un bottone assente. E su
//    telefono è nascosto, perché la barra fissa in basso ha già «Chiama» — due richiami alla
//    stessa azione, a dita di distanza, sono uno spreco di una riga di intestazione.
//
// 🔴 Il form di prenotazione **non esiste**, ed è deliberato: i ganci a database
//    (`PrenotazioniAttive`, `PrenotazioniCopertiMax`, `TurnstileSiteKey`) sono spenti e
//    restano spenti. Il richiamo è un `tel:`, come nel mockup.

import Logo from './Logo.astro';
import TemaSwitch from './TemaSwitch.astro';
import StatoApertura from './StatoApertura.astro';
import { rotteDisponibili, eCorrente } from '../lib/rotte.ts';
import type { SitoPubblico } from '../lib/tipi.ts';

interface Props {
  sito: SitoPubblico | null;
}

const { sito } = Astro.props;
const qui = Astro.url.pathname;

// 🔴 Le rotte DISPONIBILI, non tutte: due pagine esistono solo se il loro testo è stato
//    scritto, e una voce che porta a un 404 è peggio di una voce in meno.
const rotte = rotteDisponibili(sito);

// `tel:` non tollera spazi né separatori: il numero in anagrafica è scritto per essere
// letto («0445 000 000»), qui serve componibile.
const telefono = sito?.contatti.telefono?.replace(/[^\d+]/g, '') || null;
---

{/*
  ⚠️ Fondo OPACO, non `bg-sfondo/85` con la sfocatura. Due ragioni, e la seconda l'ha
     trovata la misura:

     1. il mockup di riferimento («2D Gusto — Sito») ha l'intestazione opaca. È la stesura
        precedente, quella della sola home, ad averla translucida — e dove i due divergono
        vince il riferimento;
     2. sotto un'intestazione translucida il contrasto del testo **dipende da cosa ci scorre
        sotto**, cioè non è una proprietà verificabile una volta per tutte. Con una foto
        chiara alle spalle, «Aperto · fino alle 20:00» in grigio scende sotto soglia per
        qualche centinaio di pixel di scorrimento e poi risale — un difetto che non si
        riproduce fermando la pagina.

  ⚠️ E il misuratore di contrasto non sa leggere `oklab()`: Tailwind rende `bg-sfondo/85`
     come `color-mix(in oklab, …)`, e lo script — che estrae tre numeri da una stringa —
     leggeva `0.968072 0.00123 0.0073` come se fossero componenti RGB. Il risultato era un
     3.72 identico su ogni pagina: un numero sbagliato che sembrava un difetto vero.
*/}
<header class="border-bordo bg-sfondo sticky top-0 z-50 border-b">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-3 sm:px-8">
    <a href="/" class="shrink-0" aria-label={`${sito?.insegna ?? '2 D Gusto'} — home`}>
      {/* Altezza, non larghezza: il mockup mette il marchio a 48 px, e con una misura sulla
          larghezza lo stesso logo ne veniva alto 130. Vedi il commento in `Logo.astro`. */}
      <Logo classe="h-10 sm:h-12" etichetta={null} />
    </a>

    {/* Da lg in su la navigazione sta qui, come nel mockup. */}
    <nav class="hidden flex-1 items-center justify-center gap-1 lg:flex" aria-label="Principale">
      {
        rotte.map((rotta) => (
          <a
            href={rotta.percorso}
            aria-current={eCorrente(rotta.percorso, qui) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
              eCorrente(rotta.percorso, qui)
                ? 'bg-inchiostro text-sfondo'
                : 'text-inchiostro-tenue hover:text-inchiostro',
            ]}
          >
            {rotta.etichetta}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 sm:gap-3 lg:ml-0">
      <StatoApertura classe="hidden sm:inline-flex" />
      <TemaSwitch />
      {
        telefono && (
          <a
            href={`tel:${telefono}`}
            class="bg-arancio hidden shrink-0 rounded-full px-5 py-2.5 text-sm font-bold text-[#16130F] transition-opacity hover:opacity-90 lg:block"
          >
            Prenota un tavolo
          </a>
        )
      }
    </div>
  </div>

  {/* Sotto lg: la stessa navigazione, che scorre invece di andare a capo o sparire. */}
  <nav
    class="border-bordo/60 flex gap-1 overflow-x-auto border-t px-5 py-2 lg:hidden [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    aria-label="Principale"
  >
    {
      rotte.map((rotta) => (
        <a
          href={rotta.percorso}
          aria-current={eCorrente(rotta.percorso, qui) ? 'page' : undefined}
          class:list={[
            'shrink-0 rounded-full px-3.5 py-1.5 text-[13px] font-semibold transition-colors',
            eCorrente(rotta.percorso, qui)
              ? 'bg-inchiostro text-sfondo'
              : 'text-inchiostro-tenue',
          ]}
        >
          {rotta.etichetta}
        </a>
      ))
    }
  </nav>
</header>
