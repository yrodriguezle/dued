# node_modules e dist si RICOSTRUISCONO dentro l'immagine: copiarli dall'host
# significherebbe spedire in produzione un albero installato su Windows e un bundle
# costruito con i prefissi di sviluppo — cioe' esattamente il guasto che il Dockerfile
# spiega in testa.
node_modules/
dist/
.astro/

# 🔴 Il .env locale porta API_INTERNA_URL=https://localhost:4000. Dentro il container
#    quel valore non e' raggiungibile e non e' nemmeno letto (i prefissi sono di build),
#    ma un file di configurazione che finisce in un'immagine e' comunque un file che
#    qualcuno un giorno leggera' credendolo attivo.
.env
.env.*
!.env.example

*.pem
*.key
.vscode/
.idea/
