# Config per restore-prod-to-local.sh / restore-prod-to-local.ps1
# Copia questo file in .env e compila i valori. .env e' gitignored.

# ============================================================
# SSH verso il server di produzione
# ============================================================
SSH_HOST=prod.example.com
SSH_USER=deploy
# SSH_PORT=22

# Autenticazione: chiave (consigliata) OPPURE password.
# Se SSH_KEY e' impostata, la password viene ignorata.
# SSH_KEY=~/.ssh/id_ed25519
# Su Windows il path va SEMPRE fra apici, altrimenti lo script .sh (che fa source
# di questo file) si mangia i backslash:  SSH_KEY="C:\Users\tuo\.ssh\id_ed25519"
# Se la chiave e' protetta da passphrase, mettila qui: senza, lo script fallisce
# subito (il fallback a password e' disattivato apposta, vedi commento negli script).
# SSH_PASSPHRASE=
# Password: su Linux/macOS richiede sshpass; su Windows richiede plink (PuTTY).
# Se assente, viene chiesta al prompt.
# SSH_PASSWORD=

# ============================================================
# Database di PRODUZIONE (MySQL in Docker sul server remoto)
# ============================================================
REMOTE_MYSQL_CONTAINER=mysql
PROD_DB_NAME=duedgusto
PROD_DB_USER=root
PROD_DB_PASSWORD=

# ============================================================
# Database LOCALE (destinazione del restore)
# ============================================================
# native = MySQL installato in locale | docker = MySQL in container locale
LOCAL_MODE=native

# Nome del DB locale (default: stesso nome di PROD_DB_NAME)
# LOCAL_DB_NAME=duedgusto

# --- LOCAL_MODE=native ---
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=root
# LOCAL_DB_HOST=localhost
# LOCAL_DB_PORT=3306

# --- LOCAL_MODE=docker ---
# LOCAL_MYSQL_CONTAINER=dued-mysql
# LOCAL_DOCKER_DB_PASSWORD=root

# ============================================================
# MEDIA (le fotografie caricate dalla libreria del sito)
# ============================================================
# Si scaricano insieme al database, con un rsync in mirror. Entrambi i valori hanno un
# default sensato e vanno toccati solo se la tua installazione si discosta.
#
# Radice sull'HOST di produzione: e' il lato sinistro del bind mount di docker-compose.yml
# (/opt/duedgusto/media -> /app/media). Si sincronizza quella dell'host, non quella dentro
# il container: e' la sola che sopravvive ai deploy.
# REMOTE_MEDIA_DIR=/opt/duedgusto/media
#
# Radice LOCALE. Il default e' backend/media, cioe' lo stesso ripiego che Program.cs applica
# in Development quando MEDIA_ROOT non e' impostata. Se in locale hai una MEDIA_ROOT diversa,
# valorizzala qui: altrimenti le fotografie finiscono in una cartella che il backend non
# legge, e sembra che il sync non abbia funzionato.
# LOCAL_MEDIA_DIR=/percorso/assoluto/alla/tua/media
